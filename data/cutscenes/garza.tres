[gd_resource type="Resource" script_class="Cutscene" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/story/cutscene.gd" id="1_cutscene"]

[resource]
script = ExtResource("1_cutscene")
id = "garza"
steps = [
["wait", 0.4],
["say", "", ["La Garza de légamo se desploma en el barro. De su buche rueda una lámpara que todavía brilla."]],
["say", "", ["¡Consigues la Lámpara del faro!"]],
["say", "", ["Vuelves a Brumaclara a toda prisa. Orvalla te ve llegar con la lámpara, te la quita de las manos y sube corriendo la escalera del faro."]],
["fade_out"],
["travel", "brumaclara", "cienaga"],
["fade_in"],
["camera_to", Vector3(0, 0, -15), 16.0],
["sfx", "level_up"],
["say", "", ["Una luz blanca barre la plaza y la niebla retrocede un paso."]],
["camera_back"],
["approach", "Orvalla", "hero", 1.8],
["face", "hero", "Orvalla"],
["face", "Orvalla", "hero"],
["say", "Orvalla", ["Esa garza se tragó la lámpara el invierno pasado, con farol y todo. Gracias, {nombre}.", "Mira la gente asomarse a las ventanas. Hacía años que no veían su propia calle.", "La posada vuelve a abrir. Descansa allí cuando quieras."]],
["approach", "Neblí", "hero", 2.2],
["face", "Neblí", "hero"],
["say", "Neblí", ["¿Eso es el sol?"]],
["say", "Orvalla", ["No, Neblí. Pero se le parece un poco."]]
]
