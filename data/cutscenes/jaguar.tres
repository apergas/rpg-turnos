[gd_resource type="Resource" script_class="Cutscene" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/story/cutscene.gd" id="1_cutscene"]

[resource]
script = ExtResource("1_cutscene")
id = "jaguar"
steps = [
["wait", 0.4],
["say", "", ["El Jaguar sombrío cae entre las raíces. En su cuello brilla una insignia de bronce verde."]],
["say", "", ["¡Consigues la Insignia de la jungla!"]],
["fade_out"],
["travel", "caravana", "jungla"],
["fade_in"],
["approach", "Jefe de caravana", "hero", 1.8],
["face", "hero", "Jefe de caravana"],
["say", "Jefe de caravana", ["¡Lo has conseguido! Con esa insignia, los de la jungla nos dejarán pasar.", "Pero más allá empieza el desierto, y aún no sabemos cómo cruzarlo. Descansa: montaremos el camino cuando la ruta sea segura."]]
]
