offer_lines = Array[String](["Anoche vi una luz en la ciudad abandonada. Alguien sigue vivo allí dentro, escondido en una casa.", "Dicen que las calles del sur aún se tienen en pie. ¿Lo buscarías?"])
found_lines = Array[String](["¡No me hagas daño! ...Ah, eres de la caravana.", "Llevo semanas escondido de los centinelas. Iré con vosotros: dile al Viajero que voy detrás."])
wait_lines = Array[String](["¿Has encontrado a alguien en la ciudad? Busca en las casas de la calle del sur."])
done_lines = Array[String](["¡Ha llegado! Flaco y asustado, pero vivo.", "Toma estas semillas. Las guardaba para un día como hoy."])
