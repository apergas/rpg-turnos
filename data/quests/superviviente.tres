report = "vuelve con el Jefe de caravana"
offer_lines = Array[String](["Anoche vi una luz en la ciudad abandonada. Alguien sigue vivo allí dentro, escondido en una casa.", "Dicen que las calles del sur aún se tienen en pie. ¿Lo buscarías? El Jefe te dará algo de mi parte."])
found_lines = Array[String](["¡No me hagas daño! ...Ah, eres de la caravana.", "Llevo semanas escondido de los centinelas. Iré con vosotros: dile al Jefe que voy detrás."])
wait_lines = Array[String](["¿Has encontrado a alguien en la ciudad? El Viajero dice que busques en las casas de la calle del sur."])
done_lines = Array[String](["¡Ha llegado! Flaco y asustado, pero vivo. Ya va por el segundo plato de sopa.", "Toma estas semillas, de parte del Viajero. Las guardaba para un día como hoy."])
done_flag = "superviviente_vuelve"
reward_gold = 0
reward_items = {
"semilla_fuerza": 1,
"semilla_agilidad": 1
}
