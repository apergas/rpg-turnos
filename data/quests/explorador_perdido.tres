report = "vuelve con el Jefe de caravana"
offer_lines = Array[String](["Mi hermana Nara salió a explorar la jungla hace dos días y no ha vuelto.", "Dijo que iría hacia el oeste, a un claro con piedras. ¿La buscarías? El Jefe te dará algo de nuestra parte."])
found_lines = Array[String](["¡Por fin alguien! Me torcí el tobillo huyendo de un mono que no paraba de chillar.", "Ya puedo andar. Vuelvo a la caravana: dile al Jefe que voy detrás."])
wait_lines = Array[String](["¿Has visto a Nara? La Viajera dice que fue al oeste, a un claro con piedras."])
done_lines = Array[String](["¡Nara ha vuelto! Cojeando, pero entera, y con un mono en la cabeza.", "No se lo quita. Dice que ahora son amigos.", "Ten, de parte de las dos hermanas. Y gracias."])
